#!/bin/sh
# Resolve the shared tts_reader checkout, then exec scripts/run.
#
# Install layouts supported:
# 1) Whole-repo plugin root (preferred): ANTIGRAVITY_PLUGIN_ROOT has scripts/
# 2) hosts/antigravity only, with AGENT_TTS_ROOT pointing at the clone
# 3) hosts/antigravity with .tts_root marker (written by install.sh)
# 4) Shared data-dir checkout pointer (~/.agent-tts/checkout)
# 5) hosts/antigravity living inside an uncopied checkout (../../scripts)
#
# Always exit 0 on resolution failure so a misconfigured install cannot break
# an Antigravity turn.

set -eu

read_root_file() {
  # $1 = path to a one-line absolute checkout path
  if [ -f "$1" ]; then
    # shellcheck disable=SC2002
    root=$(cat "$1" 2>/dev/null | tr -d '\r' | head -n 1)
    if [ -n "$root" ] && [ -d "$root/scripts/tts_reader" ]; then
      printf '%s\n' "$root"
      return 0
    fi
  fi
  return 1
}

resolve_root() {
  if [ -n "${AGENT_TTS_ROOT:-}" ] && [ -d "$AGENT_TTS_ROOT/scripts/tts_reader" ]; then
    printf '%s\n' "$AGENT_TTS_ROOT"
    return 0
  fi
  if [ -n "${ANTIGRAVITY_PLUGIN_ROOT:-}" ] && [ -d "$ANTIGRAVITY_PLUGIN_ROOT/scripts/tts_reader" ]; then
    printf '%s\n' "$ANTIGRAVITY_PLUGIN_ROOT"
    return 0
  fi
  here=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
  if read_root_file "$here/.tts_root"; then
    return 0
  fi
  data_dir="${AGENT_TTS_DATA_DIR:-$HOME/.agent-tts}"
  if read_root_file "$data_dir/checkout"; then
    return 0
  fi
  # Legacy Claude data dir may hold the pointer on upgraded installs.
  if read_root_file "$HOME/.claude/claude-code-tts/checkout"; then
    return 0
  fi
  if [ -d "$here/../../scripts/tts_reader" ]; then
    CDPATH= cd -- "$here/../.." && pwd
    return 0
  fi
  return 1
}

ROOT=$(resolve_root) || {
  echo "agent-tts: cannot find scripts/; run hosts/antigravity/install.sh or set AGENT_TTS_ROOT" >&2
  # Still emit Antigravity-safe stdout when invoked as the Stop hook.
  if [ "${1:-}" = "hook" ]; then
    printf '{}\n'
  fi
  exit 0
}

case "${1:-}" in
  hook)
    exec "$ROOT/scripts/run" "$ROOT/scripts/tts_reader/hook_antigravity.py"
    ;;
  cli)
    shift
    exec "$ROOT/scripts/run" "$ROOT/scripts/tts_reader/cli.py" "$@"
    ;;
  *)
    echo "usage: run hook | run cli <tts-args...>" >&2
    exit 0
    ;;
esac
